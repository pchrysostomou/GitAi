{
  "name": "gitai-cli",
  "version": "0.1.0",
  "description": "AI-powered Git repository analyzer — developer stats, hotspots, complexity trends from the terminal",
  "keywords": ["git", "ai", "cli", "developer-tools", "analytics"],
  "author": "prodromos",
  "license": "MIT",
  "bin": {
    "gitai": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --clean",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.1.0",
    "groq-sdk": "^0.7.0",
    "ora": "^8.1.1",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
